body {
    background-color: #0B0D17;
    background-image:
        radial-gradient(at 10% 20%, rgba(232, 200, 74, 0.05) 0px, transparent 50%),
        radial-gradient(at 90% 80%, rgba(59, 130, 246, 0.05) 0px, transparent 50%);
}

.gold-gradient-text {
    background: linear-gradient(135deg, #FFFFFF 0%, #E8C84A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
